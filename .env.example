# Shared
ENVIRONMENT=development
APP_NAME=Cold Room Temperature Monitoring

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=replace-with-a-strong-random-secret
API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
API_COOKIE_SECURE=false
API_TRUSTED_PROXY_ENABLED=false
API_TRUSTED_PROXY_CIDRS=
API_IP_ALLOWLIST=
API_RATE_LIMIT_PER_MINUTE=120
API_LOGIN_RATE_LIMIT_PER_MINUTE=10
API_DEV_FIXTURE_ENABLED=true
API_DATA_PROVIDER=excel_fixture
API_POLL_INTERVAL_SECONDS=60
API_FIXTURE_EXCEL_PATH=E:\Pacific Control Project\sample\dbo.COLD_ROOM_TEMP.xlsx
API_LIVE_SOURCE_URL=
API_LIVE_SOURCE_TOKEN=
API_REPORT_MAX_ROWS=250000
API_OPENAPI_ENABLED_IN_PRODUCTION=false

# Bootstrap admin is optional and should be provided by your secret manager in production.
API_BOOTSTRAP_ADMIN_EMAIL=
API_BOOTSTRAP_ADMIN_PASSWORD=

# SQL Server database
# For Docker local development, this uses the SQL Server container below.
MSSQL_DATABASE=cold_room
MSSQL_SA_PASSWORD=Replace-With-A-Strong-SqlServer-Password123!
DATABASE_URL=mssql+aioodbc://sa:Replace-With-A-Strong-SqlServer-Password123!@db:1433/cold_room?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_FIXTURES=true
